# Copy to .env and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# A free Gemini API key takes about 30 seconds:
#   https://aistudio.google.com/apikey
# No billing account or card is required.

GEMINI_API_KEY=

# --- Optional -----------------------------------------------------------------

# Pinned for reproducibility. If this pin is ever retired, gemini-flash-latest
# tracks the current generation instead.
# GEMINI_MODEL=gemini-3.6-flash

# Backup provider. One adapter serves three vendors -- set the base URL to match:
#   OpenAI  https://api.openai.com/v1
#   Groq    https://api.groq.com/openai/v1     (free tier)
#   Ollama  http://localhost:11434/v1          (local, any key value)
# LLM_PROVIDER=openai_compat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Embeddings stay on Gemini even when generation falls back: Groq serves no
# embedding models, and changing embedder mid-index silently breaks retrieval.
